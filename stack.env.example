# Copy these keys into the Portainer/Swarm stack environment for production.
# Do not store production secrets in .env.local on the VPS.

GOOGLE_PLACES_API_KEY=replace-me
GOOGLE_PLACE_ID=replace-me
GEMINI_API_KEY=replace-me

# Aulão Rosa: aviso de inscrição no WhatsApp (Evolution API) e chave da lista /aulao-rosa/inscritos?k=
EVOLUTION_URL=http://evolution_evolution_api:8080
EVOLUTION_API_KEY=replace-me
EVOLUTION_INSTANCE=caicara
AVISO_WHATSAPP=55DDDNUMERO
AULAO_LISTA_KEY=replace-me

# Pix da aula avulsa (Asaas). Sem chave, a avulsa vira "paga no box".
ASAAS_API_KEY=replace-me
ASAAS_URL=https://api.asaas.com/v3

# Loja: conta Asaas PRÓPRIA (nunca a ASAAS_API_KEY do Aulão).
# Teste: sandbox. Produção: https://api.asaas.com/v3 + chave real.
LOJA_ASAAS_API_KEY=replace-me
LOJA_ASAAS_URL=https://sandbox.asaas.com/api/v3

# Loja: token do webhook (igual ao cadastrado no painel do Asaas). Gerar: openssl rand -base64 32
ASAAS_WEBHOOK_TOKEN=replace-me

# Loja: senha do /admin e segredo do cookie da sessão. Segredo: openssl rand -base64 32
ADMIN_SENHA=replace-me
ADMIN_COOKIE_SECRET=replace-me

# Loja: endereço público (links do pedido e retorno do pagamento)
SITE_URL=https://caicara.store

# LOJA_NO_MENU não vai aqui: é fixado no build (docker build --build-arg LOJA_NO_MENU=1).
